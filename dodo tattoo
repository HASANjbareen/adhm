      --surface:  #141414;
      --surface2: #1e1e1e;
      --border:   rgba(255,255,255,0.08);
      --gold:     #c9a84c;
      --gold-lt:  #e8c96a;
      --white:    #f5f5f5;
      --gray:     #888;
      --radius:   12px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Cairo', sans-serif;
      background: var(--bg);
      color: var(--white);
      min-height: 100vh;
    }

    /* ── NAV ───────────────────────────────────── */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(10,10,10,0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      display: flex; align-items: center; justify-content: space-between;
      height: 66px;
      gap: 16px;
    }

    .logo {
      font-size: 26px; font-weight: 900; letter-spacing: 2px;
      background: linear-gradient(135deg, var(--gold), var(--gold-lt));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      text-decoration: none; white-space: nowrap;
    }

    .nav-links {
      display: flex; gap: 28px; list-style: none; align-items: center;
    }

    .nav-links a {
      color: rgba(255,255,255,0.65); text-decoration: none;
      font-size: 14px; font-weight: 600; transition: color .2s;
    }
    .nav-links a:hover { color: var(--gold-lt); }

    .btn-wa-nav {
      display: flex; align-items: center; gap: 8px;
      background: #25D366; color: #fff;
      padding: 9px 20px; border-radius: 999px;
      font-size: 13px; font-weight: 700;
      text-decoration: none; white-space: nowrap;
      transition: opacity .2s, transform .15s;
    }
    .btn-wa-nav:hover { opacity: .9; transform: translateY(-1px); }

    .hamburger {
      display: none; flex-direction: column; gap: 5px;
      cursor: pointer; padding: 4px;
    }
    .hamburger span {
      display: block; width: 24px; height: 2px;
      background: var(--white); border-radius: 2px; transition: .3s;
    }

    .mobile-menu {
      display: none; position: fixed; inset: 66px 0 0;
      background: rgba(10,10,10,0.98); z-index: 99;
      flex-direction: column; align-items: center; justify-content: center;
      gap: 32px;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      color: var(--white); text-decoration: none;
      font-size: 22px; font-weight: 700; transition: color .2s;
    }
    .mobile-menu a:hover { color: var(--gold-lt); }

    /* ── HERO ──────────────────────────────────── */
    .hero {
      position: relative; overflow: hidden;
      min-height: 540px;
      display: flex; align-items: center; justify-content: center;
      text-align: center; padding: 90px 24px;
    }

    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 900px 550px at 50% -10%, rgba(201,168,76,.18), transparent 70%),
        radial-gradient(ellipse 600px 400px at 10% 90%, rgba(201,168,76,.08), transparent 70%),
        radial-gradient(ellipse 500px 400px at 90% 80%, rgba(201,168,76,.06), transparent 70%);
      pointer-events: none;
    }

    .hero-content { position: relative; z-index: 1; max-width: 740px; }

    .hero-badge {
      display: inline-block;
      background: rgba(201,168,76,.14);
      border: 1px solid rgba(201,168,76,.38);
      color: var(--gold-lt); font-size: 13px; font-weight: 700;
      padding: 6px 22px; border-radius: 999px;
      margin-bottom: 28px; letter-spacing: 1px;
    }

    .hero h1 {
      font-size: clamp(34px, 6vw, 66px);
      font-weight: 900; line-height: 1.25; margin-bottom: 20px;
    }

    .hero h1 .accent {
      background: linear-gradient(135deg, var(--gold), var(--gold-lt));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .hero p {
      font-size: 17px; color: rgba(255,255,255,.62);
      line-height: 1.85; margin-bottom: 40px;
    }

    .hero-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

    .btn-gold {
      background: linear-gradient(135deg, var(--gold), var(--gold-lt));
      color: #0a0a0a; font-weight: 800; font-size: 15px;
      padding: 14px 34px; border-radius: 999px; border: none;
      cursor: pointer; text-decoration: none; font-family: 'Cairo', sans-serif;
      transition: transform .15s, box-shadow .15s;
      box-shadow: 0 8px 30px rgba(201,168,76,.35);
      display: inline-block;
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(201,168,76,.48); }

    .btn-outline {
      background: transparent; color: var(--white);
      font-weight: 700; font-size: 15px;
      padding: 14px 34px; border-radius: 999px;
      border: 1px solid rgba(255,255,255,.25);
      cursor: pointer; text-decoration: none; font-family: 'Cairo', sans-serif;
      transition: border-color .2s, background .2s;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-outline:hover { border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.05); }

    /* ── STATS ─────────────────────────────────── */
    .stats-bar {
      display: flex; justify-content: center; flex-wrap: wrap;
      gap: 48px; padding: 48px 24px;
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .stat { text-align: center; }
    .stat-num {
      font-size: 38px; font-weight: 900;
      background: linear-gradient(135deg, var(--gold), var(--gold-lt));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .stat-lbl { font-size: 13px; color: var(--gray); margin-top: 4px; }

    /* ── SECTION WRAPPER ───────────────────────── */
    .section { padding: 72px 24px; max-width: 1240px; margin: 0 auto; }

    .sec-head { margin-bottom: 40px; }
    .sec-title { font-size: 30px; font-weight: 900; margin-bottom: 6px; }
    .sec-sub { color: var(--gray); font-size: 14px; }

    /* ── CATEGORY PILLS ────────────────────────── */
    .cat-pills {
      display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 36px;
    }

    .cat-pill {
      padding: 9px 22px; border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface); color: rgba(255,255,255,.6);
      font-size: 14px; font-weight: 600; cursor: pointer;
      font-family: 'Cairo', sans-serif; transition: all .2s;
    }
    .cat-pill.active,
    .cat-pill:hover {
      background: var(--gold); border-color: var(--gold); color: #0a0a0a;
    }

    /* ── PRODUCT GRID ──────────────────────────── */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 20px;
    }

    .card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); overflow: hidden;
      cursor: pointer; transition: transform .2s, box-shadow .2s, border-color .2s;
    }
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 22px 55px rgba(0,0,0,.55);
      border-color: rgba(201,168,76,.35);
    }

    .card-thumb {
      width: 100%; aspect-ratio: 4/3;
      background: var(--surface2);
      display: flex; align-items: center; justify-content: center;
      font-size: 56px; transition: transform .3s;
    }
    .card:hover .card-thumb { transform: scale(1.05); }

    .card-body { padding: 16px; }

    .card-badge {
      display: inline-block;
      background: rgba(201,168,76,.14); color: var(--gold-lt);
      font-size: 11px; font-weight: 700;
      padding: 3px 10px; border-radius: 999px; margin-bottom: 8px;
    }

    .card-name {
      font-size: 15px; font-weight: 700; margin-bottom: 5px; line-height: 1.5;
    }

    .card-meta { font-size: 12px; color: var(--gray); margin-bottom: 14px; }

    .card-footer {
      display: flex; align-items: center; justify-content: space-between;
    }

    .card-price { font-size: 19px; font-weight: 900; color: var(--gold-lt); }
    .card-price small { font-size: 12px; font-weight: 400; color: var(--gray); }

    .btn-order {
      background: #25D366; color: #fff; border: none;
      border-radius: 999px; padding: 8px 16px;
      font-size: 12px; font-weight: 700; cursor: pointer;
      font-family: 'Cairo', sans-serif;
      display: flex; align-items: center; gap: 6px;
      transition: opacity .2s, transform .15s;
    }
    .btn-order:hover { opacity: .9; transform: scale(1.04); }

    /* ── HOW IT WORKS ──────────────────────────── */
    .how-section {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 72px 24px;
    }
    .how-inner { max-width: 1240px; margin: 0 auto; }

    .steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 20px; margin-top: 40px;
    }

    .step {
      text-align: center; padding: 32px 20px;
      background: var(--surface2); border-radius: var(--radius);
      border: 1px solid var(--border);
      transition: border-color .2s, transform .2s;
    }
    .step:hover { border-color: rgba(201,168,76,.3); transform: translateY(-3px); }

    .step-num {
      width: 58px; height: 58px; border-radius: 50%;
      background: linear-gradient(135deg, var(--gold), var(--gold-lt));
      color: #0a0a0a; font-size: 22px; font-weight: 900;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 18px;
    }

    .step h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .step p { font-size: 13px; color: var(--gray); line-height: 1.75; }

    /* ── FOOTER ────────────────────────────────── */
    footer {
      background: #050505;
      border-top: 1px solid var(--border);
      padding: 56px 24px 28px;
    }

    .footer-grid {
      max-width: 1240px; margin: 0 auto;
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 48px; margin-bottom: 40px;
    }

    .footer-brand .logo { display: block; font-size: 28px; margin-bottom: 14px; }
    .footer-brand p { font-size: 13px; color: var(--gray); line-height: 1.85; }

    .socials { display: flex; gap: 10px; margin-top: 20px; }
    .social-btn {
      width: 42px; height: 42px; border-radius: 50%;
      background: var(--surface2); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; text-decoration: none; color: var(--gray);
      transition: all .2s;
    }
    .social-btn:hover { background: var(--gold); border-color: var(--gold); color: #0a0a0a; }

    .footer-col h4 {
      font-size: 14px; font-weight: 700; color: var(--white);
      margin-bottom: 18px; letter-spacing: .5px;
    }
    .footer-col ul { list-style: none; }
    .footer-col li { margin-bottom: 11px; }
    .footer-col a {
      color: var(--gray); text-decoration: none;
      font-size: 13px; transition: color .2s;
    }
    .footer-col a:hover { color: var(--gold-lt); }

    .footer-bottom {
      max-width: 1240px; margin: 0 auto;
      padding-top: 24px; border-top: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      font-size: 12px; color: var(--gray); flex-wrap: wrap; gap: 8px;
    }

    /* ── FLOATING WA ───────────────────────────── */
    .wa-float {
      position: fixed; bottom: 24px; left: 24px;
      width: 58px; height: 58px;
      background: #25D366; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 28px; text-decoration: none;
      box-shadow: 0 8px 28px rgba(37,211,102,.42);
      z-index: 998; transition: transform .2s, box-shadow .2s;
    }
    .wa-float:hover { transform: scale(1.12); box-shadow: 0 12px 36px rgba(37,211,102,.55); }

    /* ── PRODUCT MODAL ─────────────────────────── */
    .overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,.82);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      z-index: 1000; display: none; place-items: center; padding: 20px;
    }
    .overlay.open { display: grid; }

    .modal {
      background: var(--surface);
      border: 1px solid rgba(201,168,76,.28);
      border-radius: 20px;
      max-width: 500px; width: 100%; overflow: hidden;
      animation: popIn .2s ease;
    }
    @keyframes popIn {
      from { transform: scale(.93); opacity: 0; }
      to   { transform: scale(1);   opacity: 1; }
    }

    .modal-thumb {
      width: 100%; aspect-ratio: 4/3;
      background: var(--surface2);
      display: flex; align-items: center; justify-content: center;
      font-size: 80px;
    }

    .modal-body { padding: 24px; }
    .modal-body h3 { font-size: 22px; font-weight: 800; margin-bottom: 8px; }
    .modal-meta { color: var(--gray); font-size: 13px; margin-bottom: 6px; }
    .modal-price { font-size: 30px; font-weight: 900; color: var(--gold-lt); margin: 12px 0 16px; }
    .modal-desc { font-size: 14px; color: rgba(255,255,255,.7); line-height: 1.75; margin-bottom: 22px; }

    .modal-actions { display: flex; gap: 12px; }
    .modal-close-btn {
      flex: 1; background: var(--surface2); border: 1px solid var(--border);
      color: var(--white); border-radius: 999px; padding: 12px;
      font-size: 14px; font-weight: 700; cursor: pointer; font-family: 'Cairo', sans-serif;
      transition: background .2s;
    }
    .modal-close-btn:hover { background: var(--surface); }
    .modal-wa-btn {
      flex: 2; background: #25D366; border: none; color: #fff;
      border-radius: 999px; padding: 12px;
      font-size: 14px; font-weight: 700; cursor: pointer;
      font-family: 'Cairo', sans-serif;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: opacity .2s;
    }
    .modal-wa-btn:hover { opacity: .9; }

    /* ── RESPONSIVE ────────────────────────────── */
    @media (max-width: 900px) {
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 600px) {
      nav { padding: 0 20px; }
      .nav-links { display: none; }
      .btn-wa-nav.desktop { display: none; }
      .hamburger { display: flex; }
      .footer-grid { grid-template-columns: 1fr; gap: 28px; }
      .stats-bar { gap: 28px; }
      .hero { min-height: 420px; padding: 70px 20px; }
    }
  </style>
</head>
