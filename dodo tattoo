        <button class="modal-wa-btn" id="m-wa-btn">💬 اطلب عبر واتساب</button>
      </div>
    </div>
  </div>
</div>

<!-- ══ SCRIPT ══════════════════════════════════════════ -->
<script>
  // ── Config ──────────────────────────────────────────
  const PHONE = '962790000000'; // ← غيّر رقم الواتساب هنا
  const WA    = `https://wa.me/${PHONE}`;

  // wire all WA links
  const waEls = ['nav-wa','hero-wa','mobile-wa-link','footer-wa','footer-wa2','wa-float'];
  waEls.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.href = WA;
  });

  // ── Products data ────────────────────────────────────
  const PRODUCTS = [
    { id:'A26', name:'تاتو وجه النمر',      cat:'20days',   size:'18×11 سم', price:5,  emoji:'🐯',
      desc:'تصميم حيواني رائع بشكل وجه نمر مفصّل وشرس. يناسب الكتف والذراع.' },
    { id:'A24', name:'تاتو أساور أنيقة',    cat:'bracelet', size:'18×11 سم', price:5,  emoji:'📿',
      desc:'أساور أنيقة تلتف حول معصمك بأسلوب جذاب ونسائي رقيق.' },
    { id:'D1',  name:'تاتو الكتف الكبير',   cat:'back',     size:'30×16 سم', price:8,  emoji:'🦋',
      desc:'تصميم كبير للكتف والظهر، مناسب للراغبين في إبراز شخصيتهم.' },
    { id:'D2',  name:'تاتو عقاب الظهر',     cat:'back',     size:'30×16 سم', price:8,  emoji:'🦅',
      desc:'عقاب جبار يمتد على ظهرك بتفاصيل احترافية مذهلة.' },
    { id:'F1',  name:'أسوارة كاملة',        cat:'bracelet', size:'20×8 سم',  price:6,  emoji:'💍',
      desc:'أسوارة كاملة تلتف حول معصمك بتصميم هندسي مميز.' },
    { id:'A1',  name:'تاتو وردة',           cat:'20days',   size:'15×10 سم', price:4,  emoji:'🌹',
      desc:'وردة جميلة بتفاصيل ناعمة، تناسب المعصم أو الرقبة أو الظهر.' },
    { id:'A2',  name:'تاتو ذئب',            cat:'20days',   size:'18×12 سم', price:5,  emoji:'🐺',
      desc:'ذئب قوي بتصميم واقعي يعكس شخصية قوية وجريئة.' },
    { id:'C1',  name:'تاتو تنين',           cat:'20days',   size:'25×15 سم', price:7,  emoji:'🐉',
      desc:'تنين أسطوري بتصميم آسيوي تقليدي، مناسب للذراع أو الساق.' },
    { id:'C2',  name:'تاتو أسد',            cat:'20days',   size:'20×15 سم', price:6,  emoji:'🦁',
      desc:'ملك الغابة بتفاصيل مذهلة، يناسب الصدر والكتف.' },
    { id:'B1',  name:'تاتو قلب',            cat:'week',     size:'10×8 سم',  price:3,  emoji:'❤️',
      desc:'قلب رومانسي بسيط وأنيق، مثالي للمناسبات والهدايا.' },
    { id:'B2',  name:'تاتو نجمة هندسية',   cat:'week',     size:'12×12 سم', price:3,  emoji:'⭐',
      desc:'نجمة هندسية مميزة تعطيك إطلالة مختلفة ومتميزة.' },
    { id:'E1',  name:'تاتو كتابة عربية',   cat:'week',     size:'15×6 سم',  price:4,  emoji:'✍️',
      desc:'جملة عربية بخط أنيق — اختر كلمتك المفضلة.' },
  ];

  const CAT_LABELS = {
    '20days':   '20 يوم',
    'week':     'أسبوع',
    'bracelet': 'أسوارة',
    'back':     'ظهر وكتف',
  };

  // ── Render ───────────────────────────────────────────
  function render(cat) {
    const list = cat === 'all' ? PRODUCTS : PRODUCTS.filter(p => p.cat === cat);
    document.getElementById('product-grid').innerHTML = list.map(p => `
      <div class="card" onclick="openModal('${p.id}')">
        <div class="card-thumb">${p.emoji}</div>
        <div class="card-body">
          <span class="card-badge">${CAT_LABELS[p.cat]}</span>
          <div class="card-name">${p.name}</div>
          <div class="card-meta">الحجم: ${p.size} · كود: ${p.id}</div>
          <div class="card-footer">
            <div class="card-price">${p.price} د.أ <small>/ قطعة</small></div>
            <button class="btn-order"
              onclick="event.stopPropagation(); order('${p.id}','${p.name}')">
              💬 اطلب
            </button>
          </div>
        </div>
      </div>
    `).join('');
  }

  function filterCat(btn, cat) {
    document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    render(cat);
  }

  // ── WhatsApp order ───────────────────────────────────
  function order(id, name) {
    const msg = `مرحبا،\nأريد الطلب:\n• التصميم: ${name}\n• الكود: ${id}`;
    window.open(`${WA}?text=${encodeURIComponent(msg)}`, '_blank');
  }

  // ── Modal ────────────────────────────────────────────
  function openModal(id) {
    const p = PRODUCTS.find(x => x.id === id);
    if (!p) return;
    document.getElementById('m-thumb').textContent = p.emoji;
    document.getElementById('m-name').textContent  = p.name;
    document.getElementById('m-meta').textContent  = `الحجم: ${p.size} · الكود: ${p.id}`;
    document.getElementById('m-price').textContent = `${p.price} د.أ`;
    document.getElementById('m-desc').textContent  = p.desc;
    document.getElementById('m-wa-btn').onclick     = () => order(p.id, p.name);
    document.getElementById('overlay').classList.add('open');
  }

  function closeOverlay() {
    document.getElementById('overlay').classList.remove('open');
  }

  function handleOverlayClick(e) {
    if (e.target === document.getElementById('overlay')) closeOverlay();
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeOverlay();
  });

  // ── Mobile nav ───────────────────────────────────────
  function toggleMenu() {
    document.getElementById('mobile-menu').classList.toggle('open');
  }

  // ── Init ─────────────────────────────────────────────
  render('all');
</script>
</body>
</html>
